# Wulo Academy — offline local demo configuration.
# Copy to .env. Contains no credentials; every cloud provider stays disabled
# because its settings are unset.

# Persistence: local SQLite metadata plus in-memory learning repository.
DATABASE_BACKEND=sqlite
LEARNING_REPOSITORY_BACKEND=memory

# Local development identity (rejected automatically on hosted environments).
LOCAL_DEV_AUTH=true
LOCAL_DEV_USER_ID=demo-teacher-001
LOCAL_DEV_USER_NAME="Demo Teacher"
LOCAL_DEV_USER_EMAIL=demo-teacher@example.test
LOCAL_DEV_USER_ROLE=teacher

# Leave all provider settings unset for the credential-free demo.
# Optional cloud integrations are documented in .env.azure.example.
