# Wulo Academy — optional Azure provider configuration (placeholders only).
# Copy values you actually use into .env alongside .env.example settings.
# Never commit a populated .env file. Every setting below is optional; the
# application runs offline without them. Using these services incurs cost.

# Azure OpenAI (tutor and analysis models)
AZURE_OPENAI_ENDPOINT=__YOUR_AZURE_OPENAI_ENDPOINT__
AZURE_OPENAI_API_KEY=__YOUR_AZURE_OPENAI_API_KEY__
MODEL_DEPLOYMENT_NAME=__YOUR_MODEL_DEPLOYMENT_NAME__

# Azure Speech (pronunciation and text-to-speech)
AZURE_SPEECH_KEY=__YOUR_AZURE_SPEECH_KEY__
AZURE_SPEECH_REGION=__YOUR_AZURE_SPEECH_REGION__

# Azure AI Content Safety (optional safeguarding layer)
AZURE_CONTENT_SAFETY_ENDPOINT=__YOUR_CONTENT_SAFETY_ENDPOINT__
AZURE_CONTENT_SAFETY_KEY=__YOUR_CONTENT_SAFETY_KEY__

# Telemetry (disabled when unset)
APPLICATIONINSIGHTS_CONNECTION_STRING=__YOUR_APP_INSIGHTS_CONNECTION_STRING__

# Production persistence (demo uses SQLite; PostgreSQL is opt-in)
DATABASE_BACKEND=sqlite
# DATABASE_URL=__YOUR_POSTGRES_CONNECTION_URL__
